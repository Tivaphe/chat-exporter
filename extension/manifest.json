{
  "manifest_version": 3,
  "name": "Chat Exporter — Discussions LLM en .txt",
  "version": "1.0.0",
  "description": "Exporte la discussion LLM ouverte (ChatGPT, Claude, Gemini, Perplexity, DeepSeek, Grok, Qwen, Arena...) en .txt / .md / .json, avec scroll automatique. Compatible Chrome et Firefox.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Exporter la discussion",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chat-exporter@github",
      "strict_min_version": "115.0"
    }
  }
}
